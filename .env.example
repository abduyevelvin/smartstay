# ─────────────────────────────────────────────────────────
#  SmartStay — Environment Variables Template
#  Copy to .env and fill in real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# PostgreSQL — Auth
POSTGRES_AUTH_USER=auth
POSTGRES_AUTH_PASSWORD=auth

# PostgreSQL — Booking
POSTGRES_BOOKING_USER=booking
POSTGRES_BOOKING_PASSWORD=booking

# PostgreSQL — pgvector (AI embeddings)
POSTGRES_VECTOR_USER=vector
POSTGRES_VECTOR_PASSWORD=vector

# MongoDB — root (used only by init script and admin tasks)
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root

# MongoDB — dedicated service users (created by infra/init-mongo.js)
MONGO_HOTEL_USER=user
MONGO_HOTEL_PASSWORD=user
MONGO_REVIEW_USER=user
MONGO_REVIEW_PASSWORD=user

# Redis
REDIS_PASSWORD=redis

# Spring AI / OpenAI (LiteLLM proxy)
SPRING_AI_OPENAI_API_KEY=sk-your-litellm-api-key

# Mail (for notification-service)
# Use Mailtrap for local dev: https://mailtrap.io
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# Admin user seed (auth-service — overrides the default admin@smartstay.com / Admin@1234)
APP_ADMIN_EMAIL=admin@smartstay.com
APP_ADMIN_PASSWORD=Admin@1234

# Internal service-to-service secret
# Must match across hotel-service and review-service.
# Used to protect the internal-only PATCH /api/v1/hotels/{id}/rating endpoint.
INTERNAL_SECRET=change_me_internal_secret
